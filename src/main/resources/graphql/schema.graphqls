scalar Date
scalar DateTime

type Query {
  movies: [Movie!]!
  movie(id: ID!): Movie
  user(id: ID!): User
  users: [User!]!
}

enum MovieProvider {
  TMDB
}

type Mutation {
  importMovie(provider: MovieProvider!, externalId: ID!): Movie!
  followUser(userId: ID!): User!
  unfollowUser(userId: ID!): User!
}

type Movie {
  id: ID!
  title: String!
  overview: String
  releaseDate: Date
  runtimeMinutes: Int
  cast: [CastMember!]!
}

type CastMember {
  personId: ID!
  name: String!
  character: String
  order: Int
}

type User {
  id: ID!
  username: String!
  email: String
  roles: [Role!]!
  following(first: Int! = 20, after: String): UserConnection!
  followers(first: Int! = 20, after: String): UserConnection!
  createdAt: DateTime!
  updatedAt: DateTime!
  lastSeenAt: DateTime
  deletedAt: DateTime
}

enum Role {
  ADMIN
  USER
}
