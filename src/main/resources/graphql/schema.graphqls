scalar Date
scalar DateTime

type Query {
  me: User!
  movies: [Movie!]!
  movie(id: ID!): Movie
  user(id: ID!): User
  users: [User!]!
  userLogs(userId: ID!, offset: Int! = 0, limit: Int! = 20): [AuditEvent!]!
}

enum MovieProvider {
  TMDB
}

type Mutation {
  signup(input: SignupInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  logout: Boolean!
  importMovie(provider: MovieProvider!, externalId: ID!): Movie!
  followUser(userId: ID!): User!
  unfollowUser(userId: ID!): User!
}

input SignupInput {
  username: String!
  email: String!
  password: String!
}

input LoginInput {
  username: String!
  password: String!
}

type AuthPayload {
  id: ID!
  username: String!
}

type Movie {
  id: ID!
  title: String!
  overview: String
  releaseDate: Date
  runtimeMinutes: Int
  cast: [CastMember!]!
}

type CastMember {
  personId: ID!
  name: String!
  character: String
  order: Int
}

type User {
  id: ID!
  username: String!
  email: String
  roles: [Role!]!
  following(offset: Int! = 0, limit: Int! = 20): [User!]!
  followers(offset: Int! = 0, limit: Int! = 20): [User!]!
  logs(offset: Int! = 0, limit: Int! = 20): [AuditEvent!]!
  createdAt: DateTime!
  updatedAt: DateTime!
  lastSeenAt: DateTime
  deletedAt: DateTime
}

enum Role {
  ADMIN
  USER
}

type AuditEvent {
  id: ID!
  operationId: ID!
  occurredAt: DateTime!
  action: String!
  actorUserId: ID!
  outcome: String!
  entityId: ID
  details: String!
}
