scalar Date

type Query {
  movies: [Movie!]!
  movie(id: ID!): Movie
}

enum MovieProvider {
  TMDB
}

type Mutation {
  importMovie(provider: MovieProvider!, externalId: ID!): Movie!
}

type Movie {
  id: ID!
  title: String!
  overview: String
  releaseDate: Date
  runtimeMinutes: Int
  cast: [CastMember!]!
}

type CastMember {
  personId: ID!
  name: String!
  character: String
  order: Int
}
